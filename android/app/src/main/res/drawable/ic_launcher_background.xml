                <item android:offset="0.0" android:color="#FF4F46E5" />
                <item android:offset="0.6" android:color="#FF3B6FE0" />
                <item android:offset="1.0" android:color="#FF06B6D4" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Soft radial highlight, top-left -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="30" android:centerY="24" android:gradientRadius="76">
                <item android:offset="0.0" android:color="#2EFFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
